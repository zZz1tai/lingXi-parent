[project]
requires = ["python-3.12"]

[dev]
build = ["pip", "install", "-r", "requirements.txt"]
run = ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${DEPLOY_RUN_PORT} --reload"]

[deploy]
build = ["pip", "install", "-r", "requirements.txt"]
run = ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${DEPLOY_RUN_PORT}"]
