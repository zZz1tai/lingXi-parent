# ============================================================
# LangChain Search Agent - Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- LLM Configuration ---
# Provider type: openai / azure / custom
LLM_PROVIDER=openai

# OpenAI API Key (or compatible API, e.g. Doubao/Coze)
OPENAI_API_KEY=sk-your-api-key-here

# Custom API Base URL (for Doubao, Coze, or other OpenAI-compatible APIs)
# Doubao example: https://ark.cn-beijing.volces.com/api/v3
# Leave empty to use default OpenAI endpoint
OPENAI_API_BASE=

# Model name
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Doubao: doubao-pro-128k, doubao-pro-32k
MODEL_NAME=gpt-4o-mini

# LLM temperature (0.0 - 2.0)
TEMPERATURE=0.7

# --- Search Configuration ---
# Tavily API Key (get from https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-key-here

# Max search results per query
SEARCH_MAX_RESULTS=5

# --- Agent Configuration ---
# Maximum agent iterations (prevents infinite loops)
MAX_ITERATIONS=5

# Tool call timeout in seconds
TOOL_TIMEOUT=30

# --- Server Configuration ---
# Server host and port (port is auto-set by sandbox via DEPLOY_RUN_PORT)
HOST=0.0.0.0
PORT=5000

# Enable debug mode (auto-reload on code changes)
DEBUG=false
