{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LingXiTerminal",
  "version": "1.0.1",
  "identifier": "com.lingxi.terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "灵犀终端管理系统",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5M0MyOTE2QTVGNDcxMjYKUldRbWNmU2xGaWs4T2VYNjBiMjZCR2NCbWphS2hjcXZrN0U5VEtpeTEyakdiL3lUZUNKQmx1bWIK",
      "endpoints": [
        "https://github.com/zZz1tai/lingXi-parent/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": ["icons/icon.ico"],
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
