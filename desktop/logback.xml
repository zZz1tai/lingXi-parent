<?xml version="1.0" encoding="UTF-8"?>
<!-- 桌面日志由管理器写入用户数据目录，避免沿用服务器的 /home/ruoyi/logs。 -->
<configuration>
  <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <charset>UTF-8</charset>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - [reqid=%X{request_id:-}] %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="console" />
  </root>
</configuration>
