  "cards": [
    {
      "dot": "cyan",
      "title": "服务间契约",
      "items": [
        "Java 经 HTTP 调用 Agent，所有非健康检查路由要求 X-Agent-Service-Key",
        "Agent 可反向调用 Java 只读工具网关 /internal/ai/tools/invoke（默认关闭）",
        "模型名、供应商密钥与 Base URL 由 Java 按请求搬运，两侧不保留模型默认值",
        "Agent 返回已校验的模型结果，Java 负责任务状态、资产关系与事务"
      ]
    },
    {
      "dot": "emerald",
      "title": "数据与控制点",
      "items": [
        "MySQL 持有业务、权限、任务状态与资产关系；OSS 承接上传与生成资产转存",
        "会话短期记忆默认进程内存，生产可切换 PostgreSQL checkpoint",
        "关键帧须用户批准后才提交视频任务；submission_uncertain 进入人工核对"
      ]
    },
    {
      "dot": "rose",
      "title": "安全与出站",
      "items": [
        "Agent 出站仅允许 OUTBOUND_ALLOWED_HOSTS 白名单内的 HTTPS 主机",
        "服务密钥与 OSS、Token 密钥存 sys_config，经参数管理→安全配置维护",
        "只读业务工具与人工确认写操作默认关闭，需 Java 与 Python 两侧开关同时开启"
      ]
    }
  ]
