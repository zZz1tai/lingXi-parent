<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingXi.ai.mapper.ModelHistoryMapper">
    
    <resultMap type="ModelHistory" id="ModelHistoryResult">
        <result property="id" column="id" />
        <result property="sessionId" column="session_id" />
        <result property="userId" column="user_id" />
        <result property="userName" column="user_name" />
        <result property="content" column="content" />
        <result property="uiJson" column="ui_json" />
        <result property="messageType" column="message_type" />
        <result property="status" column="status" />
        <result property="errorCode" column="error_code" />
        <result property="requestId" column="request_id" />
        <result property="completedAt" column="completed_at" />
        <result property="startedAt" column="started_at" />
        <result property="modelName" column="model_name" />
        <result property="tokens" column="tokens" />
        <result property="createTime" column="created_at" />
        <result property="updateTime" column="updated_at" />
    </resultMap>

    <sql id="selectModelHistoryVo">
        select id, session_id, user_id, user_name, content, ui_json, message_type, status, error_code, request_id, completed_at, started_at, model_name, tokens, created_at, updated_at from tb_model_history
    </sql>

    <select id="selectModelHistoryList" parameterType="ModelHistory" resultMap="ModelHistoryResult">
        <include refid="selectModelHistoryVo"/>
        <where>  
            <if test="sessionId != null and sessionId != ''"> and session_id = #{sessionId}</if>
            <if test="userId != null and userId != ''"> and user_id = #{userId}</if>
            <if test="userName != null and userName != ''"> and user_name like concat('%', #{userName}, '%')</if>
            <if test="modelName != null and modelName != ''"> and model_name = #{modelName}</if>
        </where>
        order by created_at asc
    </select>
    
    <select id="selectModelHistoryById" parameterType="Long" resultMap="ModelHistoryResult">
        <include refid="selectModelHistoryVo"/>
        where id = #{id}
    </select>

    <select id="selectModelHistoryBySessionId" parameterType="String" resultMap="ModelHistoryResult">
        <include refid="selectModelHistoryVo"/>
        where session_id = #{sessionId}
        order by created_at asc
    </select>

    <insert id="insertModelHistory" parameterType="ModelHistory" useGeneratedKeys="true" keyProperty="id">
        insert into tb_model_history
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="sessionId != null">session_id,</if>
            <if test="userId != null">user_id,</if>
            <if test="userName != null">user_name,</if>
            content,
            <if test="uiJson != null">ui_json,</if>
            <if test="messageType != null">message_type,</if>
            <if test="status != null">status,</if>
            <if test="errorCode != null">error_code,</if>
            <if test="requestId != null">request_id,</if>
            <if test="completedAt != null">completed_at,</if>
            <if test="startedAt != null">started_at,</if>
            <if test="modelName != null">model_name,</if>
            <if test="tokens != null">tokens,</if>
            <if test="createTime != null">created_at,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="sessionId != null">#{sessionId},</if>
            <if test="userId != null">#{userId},</if>
            <if test="userName != null">#{userName},</if>
            #{content},
            <if test="uiJson != null">#{uiJson},</if>
            <if test="messageType != null">#{messageType},</if>
            <if test="status != null">#{status},</if>
            <if test="errorCode != null">#{errorCode},</if>
            <if test="requestId != null">#{requestId},</if>
            <if test="completedAt != null">#{completedAt},</if>
            <if test="startedAt != null">#{startedAt},</if>
            <if test="modelName != null">#{modelName},</if>
            <if test="tokens != null">#{tokens},</if>
            <if test="createTime != null">#{createTime},</if>
        </trim>
    </insert>

    <update id="updateModelHistory" parameterType="ModelHistory">
        update tb_model_history
        <trim prefix="set" suffixOverrides=",">
            <if test="sessionId != null">session_id = #{sessionId},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="userName != null">user_name = #{userName},</if>
            <if test="content != null">content = #{content},</if>
            <if test="messageType != null">message_type = #{messageType},</if>
            <if test="status != null">status = #{status},</if>
            <if test="errorCode != null">error_code = #{errorCode},</if>
            <if test="requestId != null">request_id = #{requestId},</if>
            <if test="completedAt != null">completed_at = #{completedAt},</if>
            <if test="modelName != null">model_name = #{modelName},</if>
            <if test="tokens != null">tokens = #{tokens},</if>
            <if test="updateTime != null">updated_at = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteModelHistoryById" parameterType="Long">
        delete from tb_model_history where id = #{id}
    </delete>

    <delete id="deleteModelHistoryByIds" parameterType="Long[]">
        delete from tb_model_history where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <delete id="deleteModelHistoryBySessionId" parameterType="String">
        delete from tb_model_history where session_id = #{sessionId}
    </delete>
    
    <select id="selectRecentModelHistoryBySessionId" resultMap="ModelHistoryResult">
        <include refid="selectModelHistoryVo"/>
        where session_id = #{sessionId}
        order by created_at desc
        limit #{limit}
    </select>
</mapper>