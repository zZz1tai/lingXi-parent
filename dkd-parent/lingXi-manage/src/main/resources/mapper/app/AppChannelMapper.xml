<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingXi.app.mapper.AppChannelMapper">
    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="com.lingXi.app.domain.AppChannel">
        <id column="channel_id" property="channelId" />
        <result column="channel_code" property="channelCode" />
        <result column="inner_code" property="innerCode" />
        <result column="sku_id" property="skuId" />
        <result column="current_capacity" property="currentCapacity" />
        <result column="max_capacity" property="maxCapacity" />
        <result column="last_supply_time" property="lastSupplyTime" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <!-- 按照售货机编号查询货道列表 -->
    <select id="getChannelesByInnerCode" parameterType="java.lang.String" resultMap="BaseResultMap">
        SELECT * FROM tb_channel WHERE inner_code = #{innerCode}
    </select>
</mapper>
