<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lingXi.manage.mapper.UserTaskRelationMapper">
    <resultMap type="UserTaskRelation" id="UserTaskRelationResult">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="taskId" column="task_id"/>
        <result property="relationType" column="relation_type"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <sql id="selectUserTaskRelationVo">
        select id, user_id, task_id, relation_type, create_time, update_time from tb_user_task_relation
    </sql>

    <select id="selectUserTaskRelationById" parameterType="Long" resultMap="UserTaskRelationResult">
        <include refid="selectUserTaskRelationVo"/>
        where id = #{id}
    </select>

    <select id="selectUserTaskRelationList" parameterType="UserTaskRelation" resultMap="UserTaskRelationResult">
        <include refid="selectUserTaskRelationVo"/>
        <where>
            <if test="userId != null"> and user_id = #{userId}</if>
            <if test="taskId != null"> and task_id = #{taskId}</if>
            <if test="relationType != null"> and relation_type = #{relationType}</if>
        </where>
    </select>

    <insert id="insertUserTaskRelation" parameterType="UserTaskRelation" useGeneratedKeys="true" keyProperty="id">
        insert into tb_user_task_relation
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="taskId != null">task_id,</if>
            <if test="relationType != null">relation_type,</if>
            create_time,
            update_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="taskId != null">#{taskId},</if>
            <if test="relationType != null">#{relationType},</if>
            sysdate(),
            sysdate()
        </trim>
    </insert>

    <update id="updateUserTaskRelation" parameterType="UserTaskRelation">
        update tb_user_task_relation
        <trim prefix="SET" suffix="WHERE" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="taskId != null">task_id = #{taskId},</if>
            <if test="relationType != null">relation_type = #{relationType},</if>
            update_time = sysdate(),
        </trim>
        id = #{id}
    </update>

    <delete id="deleteUserTaskRelationById" parameterType="Long">
        delete from tb_user_task_relation where id = #{id}
    </delete>

    <delete id="deleteUserTaskRelationByIds" parameterType="Long[]">
        delete from tb_user_task_relation where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

    <select id="selectUserTaskRelationByTaskId" parameterType="Long" resultMap="UserTaskRelationResult">
        <include refid="selectUserTaskRelationVo"/>
        where task_id = #{taskId}
    </select>

    <select id="selectUserTaskRelationByUserId" parameterType="Long" resultMap="UserTaskRelationResult">
        <include refid="selectUserTaskRelationVo"/>
        where user_id = #{userId}
    </select>

    <select id="selectUserTaskRelationByTaskIdAndType" parameterType="UserTaskRelation" resultMap="UserTaskRelationResult">
        <include refid="selectUserTaskRelationVo"/>
        where task_id = #{taskId}
        <if test="relationType != null"> and relation_type = #{relationType}</if>
    </select>

    <delete id="deleteUserTaskRelationByTaskId" parameterType="Long">
        delete from tb_user_task_relation where task_id = #{taskId}
    </delete>
</mapper>