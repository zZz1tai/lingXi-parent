# ============================================================
# LangChain Search Agent - Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- LLM Configuration ---
# Provider type: openai / azure / custom
LLM_PROVIDER=openai

# OpenAI API Key (or compatible API, e.g. Doubao/Coze)
OPENAI_API_KEY=sk-your-api-key-here

# Custom API Base URL (for Doubao, Coze, or other OpenAI-compatible APIs)
# Doubao example: https://ark.cn-beijing.volces.com/api/v3
# Leave empty to use default OpenAI endpoint
OPENAI_API_BASE=

# Model name
# OpenAI: gpt-4o-mini, gpt-4o, gpt-4-turbo
# Doubao: doubao-pro-128k, doubao-pro-32k
MODEL_NAME=gpt-4o-mini

# LLM temperature (0.0 - 2.0)
TEMPERATURE=0.7

# --- Search Configuration ---
# Tavily API Key (get from https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-key-here

# Max search results per query
SEARCH_MAX_RESULTS=5

# --- Agent Configuration ---
# Maximum agent iterations (prevents infinite loops)
MAX_ITERATIONS=5

# Tool call timeout in seconds
TOOL_TIMEOUT=30

# --- Service Security ---
# Required on every non-health request. Configure the same value as
# AGENT_SERVICE_API_KEY in the Java service environment.
AGENT_SERVICE_API_KEY=replace-with-a-long-random-secret

# Exact provider hosts that may receive API credentials. Add the hostname from
# OPENAI_API_BASE when using another OpenAI-compatible provider.
OUTBOUND_ALLOWED_HOSTS=api.openai.com,dashscope.aliyuncs.com

# Keep false in production. Only use true with an explicitly allowlisted local
# development endpoint.
ALLOW_INSECURE_OUTBOUND_HTTP=false

# Browser CORS is unnecessary when Java is the only caller. If needed, provide
# explicit comma-separated origins (never '*').
CORS_ALLOWED_ORIGINS=
DOCS_ENABLED=false

# --- Resource Limits ---
MAX_REQUEST_BODY_BYTES=2097152
MAX_CONCURRENT_REQUESTS=32
REQUEST_QUEUE_TIMEOUT_SECONDS=5
PROVIDER_HTTP_MAX_CONNECTIONS=64
PROVIDER_HTTP_MAX_KEEPALIVE_CONNECTIONS=16
PROVIDER_HTTP_TIMEOUT_SECONDS=60
AGENT_STREAM_MAX_SECONDS=300
AGENT_STREAM_MAX_TEXT_CHARS=200000

# --- LangGraph Short-Term Memory ---
# These values are loaded through pydantic Settings from the environment or
# this .env file. Use memory only for local development/tests.
AGENT_CHECKPOINTER_BACKEND=memory
# Required when AGENT_CHECKPOINTER_BACKEND=postgres; treated as a secret.
AGENT_POSTGRES_DSN=

# --- Server Configuration ---
# Server host and port (port is auto-set by sandbox via DEPLOY_RUN_PORT)
HOST=127.0.0.1
PORT=5000

# Enable debug mode (auto-reload on code changes)
DEBUG=false
