# ============================================================
# LangChain Search Agent - Environment Configuration
# Copy this file to .env and fill in your actual values
# ============================================================

# --- LLM Runtime ---
# 模型、Base URL 与模型 API Key 由 Java 管理页逐请求传入，这里不提供兜底值。
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE=
MODEL_NAME=runtime-configured

# LLM temperature (0.0 - 2.0)
TEMPERATURE=0.7

# --- Search Configuration ---
# Tavily API Key (get from https://tavily.com)
TAVILY_API_KEY=tvly-your-tavily-key-here

# Max search results per query
SEARCH_MAX_RESULTS=5

# --- Internal Knowledge Retrieval ---
# disabled is the safe default. Use jsonl only after publishing a validated
# UTF-8 JSONL index that follows knowledge/README.md.
KNOWLEDGE_BACKEND=disabled
KNOWLEDGE_INDEX_PATH=
KNOWLEDGE_TOP_K=8
KNOWLEDGE_RERANK_TOP_N=5
KNOWLEDGE_MODEL_CHUNK_CHARS=2400
KNOWLEDGE_MAX_INDEX_BYTES=20971520

# Java Tool Gateway（默认关闭；启用后目的地必须命中精确白名单）
AGENT_TOOLS_ENABLED=false
# 仅在 Java 数据库迁移、共享密钥和持久 checkpoint 均就绪后开启
AGENT_WRITE_ACTIONS_ENABLED=false
AGENT_TOOL_BASE_URL=http://localhost:8080
AGENT_TOOL_ALLOWED_HOSTS=localhost,127.0.0.1
AGENT_TOOL_ALLOW_INSECURE_HTTP=true
AGENT_TOOL_TIMEOUT_SECONDS=20
AGENT_TOOL_MAX_RESPONSE_BYTES=262144
AGENT_TOOL_MODEL_TEXT_CHARS=12000

# --- Agent Configuration ---
# Maximum agent iterations (prevents infinite loops)
MAX_ITERATIONS=5

# Tool call timeout in seconds
TOOL_TIMEOUT=30

# --- Service Security ---
# Required on every non-health request. Configure the same value as
# AGENT_SERVICE_API_KEY in the Java service environment.
AGENT_SERVICE_API_KEY=replace-with-a-long-random-secret

# Exact provider hosts that may receive API credentials. Add the hostname from
# OPENAI_API_BASE when using another OpenAI-compatible provider.
OUTBOUND_ALLOWED_HOSTS=api.openai.com,dashscope.aliyuncs.com

# Keep false in production. Only use true with an explicitly allowlisted local
# development endpoint.
ALLOW_INSECURE_OUTBOUND_HTTP=false

# Browser CORS is unnecessary when Java is the only caller. If needed, provide
# explicit comma-separated origins (never '*').
CORS_ALLOWED_ORIGINS=
DOCS_ENABLED=false

# --- Resource Limits ---
MAX_REQUEST_BODY_BYTES=2097152
MAX_CONCURRENT_REQUESTS=32
REQUEST_QUEUE_TIMEOUT_SECONDS=5
PROVIDER_HTTP_MAX_CONNECTIONS=64
PROVIDER_HTTP_MAX_KEEPALIVE_CONNECTIONS=16
PROVIDER_HTTP_TIMEOUT_SECONDS=60
AGENT_STREAM_MAX_SECONDS=300
AGENT_STREAM_MAX_TEXT_CHARS=200000

# --- LangGraph Short-Term Memory ---
# These values are loaded through pydantic Settings from the environment or
# this .env file. Use memory only for local development/tests.
AGENT_CHECKPOINTER_BACKEND=memory
# Required when AGENT_CHECKPOINTER_BACKEND=postgres; treated as a secret.
AGENT_POSTGRES_DSN=

# --- LangGraph Long-Term Store / User Preferences ---
# Safe default is fully disabled. Production should use postgres; memory is
# only for local development/tests. The Store DSN may be omitted to reuse
# AGENT_POSTGRES_DSN.
AGENT_STORE_BACKEND=disabled
AGENT_STORE_POSTGRES_DSN=
AGENT_MEMORY_ENABLED=false
# Required when memory is enabled. Use an independent random secret with at
# least 32 bytes; rotating it intentionally starts a new user namespace.
AGENT_MEMORY_NAMESPACE_SECRET=
AGENT_MEMORY_MAX_RECALL=5
AGENT_MEMORY_WRITE_CONFIDENCE=0.9

# --- Server Configuration ---
# Server host and port (port is auto-set by sandbox via DEPLOY_RUN_PORT)
HOST=127.0.0.1
PORT=5000

# Enable debug mode (auto-reload on code changes)
DEBUG=false
